{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset manifest for the Sleep Outcome Predictor",
  "type": "object",
  "required": ["id", "title", "owner", "source", "n", "target", "inputs", "features", "models", "insights"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "owner": {"type": "object", "required": ["name"]},
    "source": {"type": "object", "required": ["name", "citation"]},
    "n": {"type": "integer", "minimum": 1},
    "target": {"type": "object", "required": ["label", "definition", "positive", "negative", "prevalence"]},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["key", "label", "control"],
        "properties": {"control": {"enum": ["slider", "number", "select", "time"]}}
      }
    },
    "features": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "onnxInput", "dtype", "from"],
        "properties": {"dtype": {"enum": ["float32", "string"]}}
      }
    },
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "file", "threshold", "metrics", "recommended", "highestF1"],
        "properties": {
          "id": {"enum": ["lr", "dt", "rf"]},
          "threshold": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "insights": {"type": "object"},
    "evaluationNote": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}